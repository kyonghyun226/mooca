rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return ['kyonghyun226@gmail.com'];
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || (
            request.auth.token.email is string
            && request.auth.token.email in adminEmails()
            && (
              request.auth.token.email_verified == true
              || request.auth.token.firebase.sign_in_provider == 'password'
            )
          )
        );
    }

    function isKnownAppId(appId) {
      return appId in ['seesaw', 'pooptime', 'randomdrop', 'banjjak', 'ieum'];
    }

    function isImageUpload(maxBytes) {
      return request.resource == null
        || (request.resource.size < maxBytes
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']);
    }

    match /shop/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && fileName.matches('^[^/]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }

    match /studio/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && fileName.matches('^[^/]+\\.(jpg|jpeg|png|webp)$')
        && isImageUpload(8 * 1024 * 1024);
    }

    match /apps/{appId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && isKnownAppId(appId)
        && fileName.matches('^(icon\\.(png|svg|webp)|mockup-[0-9]+\\.(jpg|jpeg|png|webp))$')
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType in [
          'image/png',
          'image/svg+xml',
          'image/webp',
          'image/jpeg'
        ];
    }

    match /apps/{appId}/mockups/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && isKnownAppId(appId)
        && fileName.matches('^[0-2]\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType in [
          'image/png',
          'image/webp',
          'image/jpeg'
        ];
    }
  }
}
